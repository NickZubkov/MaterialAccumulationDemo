# ---- Unity generated folders ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore .meta files for assets that are tracked
!/[Aa]ssets/**/*.meta

# ---- IDE / tooling ----
.idea/
.vs/
.gradle/
.consulo/
ExportedObj/

# ---- Auto-generated solution and project files ----
/*.csproj
/*.unityproj
/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Build artifacts ----
*.apk
*.aab
*.unitypackage
*.app

# ---- Crash / diagnostics ----
sysinfo.txt
crashlytics-build.properties

# ---- Addressables ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Внутренние документы (не попадают в репозиторий) ----
/Docs/
